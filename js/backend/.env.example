# CHOPA TECH — backend environment variables
# Copy this file to .env and fill in real values. NEVER commit .env.

# --- App ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
TIMEZONE=Africa/Dar_es_Salaam
CURRENCY=TZS

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL="postgresql://chopa:changeme@localhost:5432/chopa_tech?schema=public"

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_SECRET=replace-with-another-long-random-string
COOKIE_SECRET=replace-with-another-long-random-string

# --- MikroTik ---
# Individual router credentials are stored encrypted in the database (see RouterCredential model),
# not here. This key is used to encrypt/decrypt them at rest.
ROUTER_CREDENTIALS_ENCRYPTION_KEY=replace-with-a-32-byte-key

# --- Payments (leave blank until you have real provider credentials) ---
PAYMENTS_MODE=mock   # mock | live
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_WEBHOOK_SECRET=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_WEBHOOK_SECRET=
MIXX_YAS_API_KEY=
MIXX_YAS_WEBHOOK_SECRET=
HALOPESA_API_KEY=
HALOPESA_WEBHOOK_SECRET=

# --- SMS (leave blank until you have real provider credentials) ---
SMS_MODE=mock   # mock | live
SMS_PROVIDER=   # e.g. beem, africastalking, twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=CHOPA

# --- RADIUS (optional, future phase) ---
RADIUS_ENABLED=false
RADIUS_DB_URL=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
